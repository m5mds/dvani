# Dependencies and local runtime
node_modules/
.env
.env.*

# OS/editor noise
.DS_Store
Thumbs.db
desktop.ini

# Generated browser profiles and QA artifacts
tasks/chrome-*/
tasks/chrome-profile-*/
tasks/.chrome-profile-*/
tasks/.version-*/
tasks/chrome-test-profile/
tasks/screenshots/
tasks/profile-review/
tasks/*.json
!tasks/cinematic-toolchain.json
tasks/*contactsheet.jpg

# Logs and temporary files
*.log
*.tmp
__pycache__/
*.pyc

# Local source, QA, prototypes, and exported recordings.
# `tasks/*` rather than `tasks/` so the negations below can take effect - git will
# not descend into an excluded directory, so `!tasks/file` is silently ignored when
# the parent is excluded as `tasks/`.
tasks/*
# The client-logo pipeline is tracked: without it a fresh clone cannot rebuild
# assets/client-logos-monochrome, and code review of logo changes is impossible
# because the commits contain only binary PNGs.
!tasks/build-client-logo-pack.py
!tasks/check-client-logo-pack.py
!tasks/logo_ingest.py
!tasks/rasterise-brand-svg.js
!tasks/tune-logo-hardening.py
!tasks/extract-profile-logo-crops.py
!tasks/verify-mobile.js
# verify-mobile.js requires serve-static.js, and the PAGE_CROP gate in
# check-client-logo-pack.py is inert without its baseline - both were
# untracked, so the harness and the gate only worked on one machine.
!tasks/serve-static.js
!tasks/client-logo-baseline.json
# The masters are gitignored third-party artwork, so a clone cannot run
# build-client-logo-pack.py at all. This applies the repairs that need only the
# shipped PNGs, and rebuilds a single mark from artwork someone hands over.
!tasks/repair-built-marks.py
!tasks/rebuild-mark.ps1
docs/
prototypes/
exports/
tmp/
assets/browser-upscaled/
assets/hires/
assets/profile-client-logos/
# Official client brand artwork stays local: this repo is public, and the masters
# are third-party trademarked assets. Only the derived silhouettes ship. The
# provenance record is tracked so the pack stays auditable.
assets/brand-sources/*
!assets/brand-sources/SOURCES.tsv
assets/cinematic/division-v1/
assets/cinematic/division-v2/
assets/cinematic/hero-v1/source/

# An unrelated project (with its own node_modules) sitting in the working tree.
# One `git add -A` away from landing in this repo permanently.
deco deployment/

# Same rule as brand-sources above, applied where it was being missed: these are
# third-party client brand masters and this repo is public. Only the derived
# monochrome silhouettes in assets/client-logos-monochrome/ ship.
assets/client-logos/

# Commercial registration, national address and certification scans. Company
# identity documents do not belong in a public repo - nothing renders them
# either, certificates.html is only a redirect to the About section.
assets/certificates/

# Working tiers of the photo restoration: multi-megabyte masters and rejected
# takes. Only the derived assets/restored/web/ versions ship.
assets/restored/masters/
assets/restored/rejected/
