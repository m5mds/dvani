# Dependencies and local runtime
node_modules/
.env
.env.*

# OS/editor noise
.DS_Store
Thumbs.db
desktop.ini

# Generated browser profiles and QA artifacts
tasks/chrome-*/
tasks/chrome-profile-*/
tasks/.chrome-profile-*/
tasks/.version-*/
tasks/chrome-test-profile/
tasks/screenshots/
tasks/profile-review/
tasks/*.json
!tasks/cinematic-toolchain.json
tasks/*contactsheet.jpg

# Logs and temporary files
*.log
*.tmp
__pycache__/
*.pyc

# Local source, QA, prototypes, and exported recordings.
# `tasks/*` rather than `tasks/` so the negations below can take effect - git will
# not descend into an excluded directory, so `!tasks/file` is silently ignored when
# the parent is excluded as `tasks/`.
tasks/*
# The client-logo pipeline is tracked: without it a fresh clone cannot rebuild
# assets/client-logos-monochrome, and code review of logo changes is impossible
# because the commits contain only binary PNGs.
!tasks/build-client-logo-pack.py
!tasks/check-client-logo-pack.py
!tasks/logo_ingest.py
!tasks/rasterise-brand-svg.js
!tasks/tune-logo-hardening.py
!tasks/extract-profile-logo-crops.py
docs/
prototypes/
exports/
tmp/
assets/browser-upscaled/
assets/hires/
assets/profile-client-logos/
# Official client brand artwork stays local: this repo is public, and the masters
# are third-party trademarked assets. Only the derived silhouettes ship. The
# provenance record is tracked so the pack stays auditable.
assets/brand-sources/*
!assets/brand-sources/SOURCES.tsv
assets/cinematic/division-v1/
assets/cinematic/division-v2/
assets/cinematic/hero-v1/source/
